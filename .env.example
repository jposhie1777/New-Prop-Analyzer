BDL_API_KEY= # your BALLDONTLIE key, server-side only, never prefix with NEXT_PUBLIC_
BDL_TIER=mock # goat | allstar | trial | free | mock (mock needs no key)
SITE_PASSWORD= # optional: when set, every page and API route needs this password (one sign-in per device)
SYNC_GITHUB_TOKEN= # optional: GitHub token with Gists read/write, syncs the slip and sportsbooks across devices
